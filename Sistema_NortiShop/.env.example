# Marcadores: no son secretos válidos. Genere valores locales con:
#   python -m nortishop.cli new-keys > .env
# En producción las llaves las entrega un gestor de secretos o KMS.
# NORTISHOP_DATA_KEYS admite varias versiones; la última es la activa (rotación).
NORTISHOP_DATA_KEYS=v1:<BASE64_DE_32_BYTES>
NORTISHOP_INDEX_KEY_B64=<BASE64_DE_32_BYTES_DISTINTOS>
NORTISHOP_AUDIT_KEY_B64=<BASE64_DE_32_BYTES_DISTINTOS>
NORTISHOP_PSEUDO_KEY_B64=<BASE64_DE_32_BYTES_DISTINTOS>
NORTISHOP_DB=instance/nortishop.db
